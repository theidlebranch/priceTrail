# Vercel sends this as Authorization: Bearer on each schedule request.
# At least 16 characters, no spaces. Leave empty until the schedules are on.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
# Internet Archive keys for a changed page. The schedule reads these on Vercel.
IA_ACCESS_KEY=
IA_SECRET_KEY=
# Neon Postgres URL: postgres:// or postgresql:// with a host.
# Copy this file to .env and fill in the real URL. .env is gitignored.
DATABASE_URL=
# Empty schema-only Neon branch for the seed database tests.
# Leave this blank to skip those tests. Do not reuse DATABASE_URL after pnpm seed.
TEST_DATABASE_URL=
# Auth.js encrypts the review session cookie with this.
# Leave it empty until you sign in. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client. Callback: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app. Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Who may open /review. Comma-separated provider:accountId pairs.
# Example: google:109876543210987654321,github:42
# Empty means nobody. Do not put an email or a display name here.
REVIEWER_ALLOWLIST=
