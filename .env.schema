# Internet Archive keys for the Wayback spike. Leave empty until you run that script.
IA_ACCESS_KEY=
IA_SECRET_KEY=
# Neon Postgres URL: postgres:// or postgresql:// with a host.
# Copy this file to .env and fill in the real URL. .env is gitignored.
DATABASE_URL=
# Empty schema-only Neon branch for the seed database tests.
# Leave this blank to skip those tests. Do not reuse DATABASE_URL after pnpm seed.
TEST_DATABASE_URL=
