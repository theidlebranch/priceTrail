{
  "name": "price-trail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "spike:sources": "tsx scripts/spike-sources.ts",
    "spike:wayback": "tsx --env-file=.env scripts/spike-wayback.ts",
    "compare:models-dev-anthropic": "tsx scripts/compare-models-dev-anthropic.ts",
    "db:ping": "tsx --env-file=.env scripts/db-ping.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:pending": "tsx --env-file=.env scripts/seed-pending-example.ts",
    "seed:google": "tsx --env-file=.env scripts/seed-google-catalog.ts",
    "review:requeue-google": "tsx --env-file=.env scripts/requeue-google.ts",
    "archive:google-markdown": "tsx --env-file=.env scripts/rearchive-google-markdown.ts",
    "review:clear-same-price": "tsx --env-file=.env scripts/clear-same-price.ts",
    "prices:link-evidence": "tsx --env-file=.env scripts/link-price-evidence.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opentelemetry/api": "~1.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.1.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.11"
}
